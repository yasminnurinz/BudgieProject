<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4FAF5"
    tools:context=".ExpensesActivity">

    <!-- Top Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="8dp">

        <androidx.cardview.widget.CardView
            android:layout_width="38dp"
            android:layout_height="38dp"
            app:cardCornerRadius="19dp"
            app:cardElevation="2dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/logobudgie" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" Budgie Expenses"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#2E7D32" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Add Expense Card Form -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/white"
                android:padding="16dp"
                android:elevation="1dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add expense"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#212121"
                    android:layout_marginBottom="10dp" />

                <EditText
                    android:id="@+id/editTextAmount"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:background="@drawable/edittext_border"
                    android:hint="Amount (RM)"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="12dp"
                    android:textSize="14sp"
                    android:layout_marginBottom="10dp" />

                <EditText
                    android:id="@+id/editTextTitle"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:background="@drawable/edittext_border"
                    android:hint="Expense title (e.g. Campus lunch)"
                    android:inputType="text"
                    android:paddingHorizontal="12dp"
                    android:textSize="14sp"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:background="@drawable/edittext_border"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="8dp"
                    android:layout_marginBottom="10dp">

                    <Spinner
                        android:id="@+id/spinnerCategory"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </LinearLayout>

                <EditText
                    android:id="@+id/editTextDate"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:background="@drawable/edittext_border"
                    android:hint="Select Date (Tap to open calendar)"
                    android:focusable="false"
                    android:clickable="true"
                    android:paddingHorizontal="12dp"
                    android:textSize="14sp"
                    android:drawableEnd="@android:drawable/ic_menu_my_calendar"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/buttonAddExpense"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:backgroundTint="#4CAF50"
                    android:text="+ Add expense"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Transactions List Card Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/white"
                android:padding="16dp"
                android:elevation="1dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Transactions"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#212121"
                    android:layout_marginBottom="10dp" />

                <!-- Category Filter Tabs Horizontal Scroll -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/filterAll"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:text="All"
                            android:textSize="12sp"
                            android:backgroundTint="#4CAF50"
                            android:textColor="@color/white"
                            android:textAllCaps="false"
                            android:layout_marginEnd="6dp" />

                        <Button
                            android:id="@+id/filterFood"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:text="Food"
                            android:textSize="12sp"
                            android:backgroundTint="#E2F3E4"
                            android:textColor="#2E7D32"
                            android:textAllCaps="false"
                            android:layout_marginEnd="6dp" />

                        <Button
                            android:id="@+id/filterTransport"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:text="Transportation"
                            android:textSize="12sp"
                            android:backgroundTint="#E2F3E4"
                            android:textColor="#2E7D32"
                            android:textAllCaps="false"
                            android:layout_marginEnd="6dp" />

                        <Button
                            android:id="@+id/filterEducation"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:text="Education"
                            android:textSize="12sp"
                            android:backgroundTint="#E2F3E4"
                            android:textColor="#2E7D32"
                            android:textAllCaps="false"
                            android:layout_marginEnd="6dp" />

                        <Button
                            android:id="@+id/filterBills"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:text="Bills"
                            android:textSize="12sp"
                            android:backgroundTint="#E2F3E4"
                            android:textColor="#2E7D32"
                            android:textAllCaps="false" />
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- ListView for transactions -->
                <ListView
                    android:id="@+id/listViewExpenses"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:divider="#EEEEEE"
                    android:dividerHeight="1dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:orientation="horizontal"
        android:background="@color/white"
        android:elevation="8dp"
        android:gravity="center">

        <Button
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:text="Home"
            android:textAllCaps="false"
            android:textColor="#666666"
            android:textSize="11sp"
            android:onClick="goHome" />

        <Button
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="#E2F3E4"
            android:text="Expenses"
            android:textAllCaps="false"
            android:textColor="#2E7D32"
            android:textSize="11sp" />

        <Button
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:text="Budget"
            android:textAllCaps="false"
            android:textColor="#666666"
            android:textSize="11sp"
            android:onClick="goBudget" />

        <Button
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:text="Shopping"
            android:textAllCaps="false"
            android:textColor="#666666"
            android:textSize="11sp"
            android:onClick="goShopping" />

        <Button
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:text="Reports"
            android:textAllCaps="false"
            android:textColor="#666666"
            android:textSize="11sp"
            android:onClick="goReports" />
    </LinearLayout>

</LinearLayout>