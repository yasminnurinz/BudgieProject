<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="12dp"
    android:background="@color/white">

    <!-- Category Icon Circle -->
    <ImageView
        android:id="@+id/imgCategoryIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="12dp"
        android:padding="8dp"
        android:background="#E8F5E9"
        android:src="@android:drawable/ic_menu_agenda" />

    <!-- Title and Subtitle -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvItemTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Campus lunch"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="#212121" />

        <TextView
            android:id="@+id/tvItemSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Education · Oct 28"
            android:textSize="12sp"
            android:textColor="#7C7C7C" />
    </LinearLayout>

    <!-- Amount -->
    <TextView
        android:id="@+id/tvItemAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-RM 12.50"
        android:textStyle="bold"
        android:textSize="14sp"
        android:textColor="#212121"
        android:layout_marginEnd="12dp" />

    <!-- Edit Button -->
    <Button
        android:id="@+id/btnEditRow"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@android:color/transparent"
        android:text="✎"
        android:textColor="#555555"
        android:textSize="14sp"
        android:padding="0dp"
        android:layout_marginEnd="6dp" />

    <!-- Delete Button -->
    <Button
        android:id="@+id/btnDeleteRow"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@android:color/transparent"
        android:text="🗑"
        android:textColor="#888888"
        android:textSize="13sp"
        android:padding="0dp" />

</LinearLayout>