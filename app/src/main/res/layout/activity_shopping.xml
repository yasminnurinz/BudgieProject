<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4FAF5"
    tools:context=".ShoppingActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="8dp">

        <androidx.cardview.widget.CardView
            android:layout_width="38dp"
            android:layout_height="38dp"
            app:cardCornerRadius="19dp"
            app:cardElevation="2dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/logobudgie" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" Budgie Shopping"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#2E7D32" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                android:padding="16dp"
                android:orientation="vertical"
                android:background="#4CAF50">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Shopping budget left"
                    android:textColor="#E8F5E9"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvShoppingBudgetLeft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:padding="8dp"
                        android:orientation="vertical"
                        android:background="#66BB6A">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Budget"
                            android:textColor="#E8F5E9"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvBoxBudget"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="4dp"
                        android:padding="8dp"
                        android:orientation="vertical"
                        android:background="#66BB6A">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Est. total"
                            android:textColor="#E8F5E9"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvBoxEstTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:padding="8dp"
                        android:orientation="vertical"
                        android:background="#66BB6A">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="In cart"
                            android:textColor="#E8F5E9"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvBoxInCart"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/white"
                android:padding="16dp"
                android:elevation="1dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Shopping budget"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="#212121"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/editTextShoppingBudget"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/edittext_border"
                        android:hint="50"
                        android:inputType="numberDecimal"
                        android:paddingHorizontal="12dp"
                        android:textSize="15sp"
                        android:layout_marginEnd="10dp" />

                    <Button
                        android:id="@+id/buttonSetShoppingBudget"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:backgroundTint="#4CAF50"
                        android:text="Set"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/white"
                android:padding="16dp"
                android:elevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Checklist"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="#212121" />

                    <TextView
                        android:id="@+id/tvChecklistProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#7C7C7C"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <EditText
                        android:id="@+id/editTextItemName"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1.4"
                        android:background="@drawable/edittext_border"
                        android:hint="Item name"
                        android:inputType="text"
                        android:paddingHorizontal="10dp"
                        android:textSize="13sp"
                        android:layout_marginEnd="6dp" />

                    <EditText
                        android:id="@+id/editTextItemPrice"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="0.8"
                        android:background="@drawable/edittext_border"
                        android:hint="RM"
                        android:inputType="numberDecimal"
                        android:paddingHorizontal="10dp"
                        android:textSize="13sp"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/buttonAddItem"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:backgroundTint="#4CAF50"
                        android:text="+"
                        android:textSize="18sp"
                        android:textColor="@color/white"
                        android:padding="0dp" />
                </LinearLayout>

                <ListView
                    android:id="@+id/listViewChecklist"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:divider="#EEEEEE"
                    android:dividerHeight="1dp"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/tvClearChecked"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Clear checked items"
                    android:textColor="#2E7D32"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:paddingVertical="4dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:orientation="horizontal"
        android:background="@color/white"
        android:elevation="8dp"
        android:gravity="center">

        <Button
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:text="Home"
            android:textAllCaps="false"
            android:textColor="#666666"
            android:textSize="11sp"
            android:onClick="goHome" />

        <Button
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:text="Expenses"
            android:textAllCaps="false"
            android:textColor="#666666"
            android:textSize="11sp"
            android:onClick="goExpenses" />

        <Button
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:text="Budget"
            android:textAllCaps="false"
            android:textColor="#666666"
            android:textSize="11sp"
            android:onClick="goBudget" />

        <Button
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="#E2F3E4"
            android:text="Shopping"
            android:textAllCaps="false"
            android:textColor="#2E7D32"
            android:textSize="11sp" />

        <Button
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:text="Reports"
            android:textAllCaps="false"
            android:textColor="#666666"
            android:textSize="11sp"
            android:onClick="goReports" />
    </LinearLayout>

</LinearLayout>